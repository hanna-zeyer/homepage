---
import BaseLayout from '../layouts/BaseLayout.astro';
import { links } from '../lib/links';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Vita" backHref={base}>
  <div class="about-container">
    <div class="about-content">
      <div class="about-image">
        <img src={`${base}img/photo_5472095494445144541_y.webp`} alt="Ein Portrait von Hanna Zeyer" />
      </div>
      <div class="about-text">
        <a href={base} class="site">Hanna Zeyer</a> studierte Bühnen- und
        Kostümbild an der Hochschule für Bildende Künste Dresden. Ihre Arbeit
        bewegt sich zwischen interaktiven Raumkonzepten, performativen und
        partizipativen Formaten sowie Bildungsprojekten und der
        Auseinandersetzung mit gesellschaftlicher Stigmatisierung und
        psychosozialen Themen. Daraus entwickelte sich zunehmend ein
        Schwerpunkt in der inklusiven Kunst- und Theaterpraxis. 
        <br> <br> 
        Neben Projekten an der Semperoper Dresden und dem Staatsschauspiel Dresden
        war sie im Rahmen des Pop-Kultur Festivals 2021 als Ausstatterin für
        das Theater RambaZamba tätig. Darüber hinaus arbeitete sie mit dem <a
            href="https://www.gintersdorferklassen.org/ueber/">Gintersdorfer/Klaßen</a>
        Kollektiv sowie Künstler*innen des <a
            href="https://www.atelier-goldstein.de/">Atelier Goldstein</a>
        zusammen. Zuletzt war sie als künstlerische Mitarbeiterin bei <a 
            href="https://www.farbwerk-kultur.de/">farbwerk</a>
         tätig. Aktuell arbeitet sie als Projektmitarbeiterin im Programm
         <a 
             href="https://www.burgtheater.at/jetzt">JETZT!</a>
         des Burgtheaters und der Musik und Kunst Privatuniversität der
        Stadt Wien, als Redakteurin beim Dachverband <a
            href="https://www.eucrea.de/">EUCREA</a> sowie in der
        Öffentlichkeitsarbeit für <a
            href="https://www.farbwerk-kultur.de/">farbwerk</a>.
      </div>
    </div>
  </div>
</BaseLayout>
